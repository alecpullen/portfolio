---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false">
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>
		<div class="nav-right">
			<div class="page-nav">
				<a href="#about">About</a>
				<a href="#projects">Projects</a>
				<a href="#contact">Contact</a>
			</div>
			<div class="social-links">
				<a href="https://www.linkedin.com/in/alec-pullen-97473b272" target="_blank">
					<span class="sr-only">Go to my LinkedIn</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
						<path
							fill="currentColor"
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
						></path>
					</svg>
				</a>
				<a href="https://github.com/alecpullen" target="_blank">
					<span class="sr-only">Go to my GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
			</div>
		</div>
	</nav>
</header>

<script>
	const toggle = document.querySelector('.menu-toggle');
	const navRight = document.querySelector('.nav-right');
	if (toggle && navRight) {
		toggle.addEventListener('click', () => {
			const isOpen = navRight.classList.toggle('open');
			toggle.setAttribute('aria-expanded', String(isOpen));
		});
	}
</script>

<style>
	header {
		margin: 0;
		background: rgba(9, 10, 13, 0.9);
		backdrop-filter: blur(8px);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
		border-bottom: 1px solid var(--border-color);
		padding: 1rem 2rem;
		position: sticky;
		top: 0;
		z-index: 100;
	}
	h2 {
		margin: 0;
		font-size: 1.15em;
		font-weight: 600;
	}
	h2 a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
	}
	nav a {
		padding: 0.5em 0.5em;
		color: rgb(var(--black));
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom: 2px solid var(--accent);
	}
	.menu-toggle {
		display: none;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.25rem;
		flex-direction: column;
		gap: 4px;
	}
	.menu-toggle .bar {
		display: block;
		width: 22px;
		height: 2px;
		background: rgb(var(--black));
		border-radius: 1px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 2rem;
	}
	.page-nav {
		display: flex;
		gap: 1.75rem;
	}
	.page-nav a {
		font-size: 0.85rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		padding: 0;
		transition: color 0.15s;
	}
	.page-nav a:hover {
		color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
		gap: 1rem;
		align-items: center;
	}
	.social-links a svg {
		color: rgb(var(--gray-dark));
		transition: color 0.2s ease;
	}
	.social-links a:hover svg {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		header {
			padding: 1rem 1.25rem;
		}
		.menu-toggle {
			display: flex;
		}
		.nav-right {
			display: none;
			width: 100%;
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
			padding-top: 1rem;
		}
		.nav-right.open {
			display: flex;
		}
		.page-nav,
		.social-links {
			display: flex;
		}
		.page-nav {
			flex-direction: column;
			gap: 0.75rem;
		}
		.social-links {
			gap: 1rem;
		}
	}
</style>
