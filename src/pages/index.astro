---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- HERO -->
			<section class="hero">
				<div class="hero-label">whoami</div>
				<h1>Alec Pullen</h1>
				<p class="hero-title">Cybersecurity Graduate</p>
				<p class="hero-bio">Building secure systems and tools from low-level shells to full-stack applications.</p>
				<div class="hero-actions">
					<a href="#projects" class="btn btn-primary">View Projects</a>
					<a href="" class="btn btn-secondary">Resume</a>
				</div>
			</section>

			<hr class="divider" />

			<!-- ABOUT -->
			<section id="about" class="section">
				<h2 class="section-heading"><span class="prompt">//</span> About</h2>
				<p>
					I hold a Bachelor's degree in Cybersecurity and have experience across the full stack,
					from systems programming in C++ and Go to building web applications and iOS apps.
				</p>
				<p>
					My work spans security tooling, developer infrastructure, and application development.
					I enjoy working close to the metal as much as building user-facing products.
				</p>

				<!-- SKILLS -->
				<div class="skills">
					<div class="skill-group">
						<span class="skill-label">Languages</span>
						<div class="pills">
							<span class="pill">Python</span>
							<span class="pill">Go</span>
							<span class="pill">C++</span>
							<span class="pill">Swift</span>
							<span class="pill">TypeScript</span>
							<span class="pill">Java</span>
						</div>
					</div>
					<div class="skill-group">
						<span class="skill-label">Tools</span>
						<div class="pills">
							<span class="pill">Linux</span>
							<span class="pill">Git</span>
							<span class="pill">Wireshark</span>
							<span class="pill">Docker</span>
							<span class="pill">AI</span>
						</div>
					</div>
				</div>
			</section>

			<hr class="divider" />

			<!-- PROJECTS -->
			<section id="projects" class="section">
				<h2 class="section-heading"><span class="prompt">//</span> Projects</h2>
				<div class="project-grid">
					<article class="project-card">
						<div class="card-image">
							<img src="/projects/bezel.png" alt="Bezel screenshot" />
						</div>
						<div class="card-content">
							<div class="card-body">
								<h3 class="card-title">Bezel</h3>
								<p class="card-desc">A Wayland compositor shell built from scratch with a custom OpenGL rendering pipeline. Includes Tuner, a companion Go CLI and TUI for system configuration.</p>
							</div>
							<div class="card-footer">
								<span class="badge">C++</span>
								<span class="badge">OpenGL</span>
								<span class="badge">Wayland</span>
								<span class="badge">Go</span>
							</div>
						</div>
					</article>

					<article class="project-card">
						<div class="card-image">
							<img src="/projects/marshal.png" alt="Marshal screenshot" />
						</div>
						<div class="card-content">
							<div class="card-body">
								<h3 class="card-title">Marshal</h3>
								<p class="card-desc">An AI-assisted swarm coding tool with a terminal UI for coordinating multi-agent code generation tasks across a codebase.</p>
							</div>
							<div class="card-footer">
								<span class="badge">Go</span>
								<span class="badge">TUI</span>
							</div>
						</div>
					</article>

					<article class="project-card">
						<div class="card-image">
							<img src="/projects/eventdesk.png" alt="EventDesk screenshot" />
						</div>
						<div class="card-content">
							<div class="card-body">
								<h3 class="card-title">EventDesk</h3>
								<p class="card-desc">A CRM built for an AV company to manage clients, events, and equipment inventory end-to-end.</p>
							</div>
							<div class="card-footer">
								<span class="badge">Vite</span>
								<span class="badge">Express</span>
								<span class="badge">TypeScript</span>
							</div>
						</div>
					</article>

					<article class="project-card">
						<div class="card-image">
							<img src="/projects/horizon.png" alt="Horizon Data screenshot" />
						</div>
						<div class="card-content">
							<div class="card-body">
								<h3 class="card-title">Horizon Data</h3>
								<p class="card-desc">University capstone — a data visualization web app for exploring and analyzing large datasets.</p>
							</div>
							<div class="card-footer">
								<span class="badge">Vite</span>
								<span class="badge">Flask</span>
								<span class="badge">Python</span>
							</div>
						</div>
					</article>

					<article class="project-card">
						<div class="card-image">
							<img src="/projects/msgapp.png" alt="msgApp screenshot" />
						</div>
						<div class="card-content">
							<div class="card-body">
								<h3 class="card-title">msgApp</h3>
								<p class="card-desc">A secure end-to-end encrypted messaging app for iOS with a native SwiftUI interface.</p>
							</div>
							<div class="card-footer">
								<span class="badge">Swift</span>
								<span class="badge">SwiftUI</span>
							</div>
						</div>
					</article>
				</div>
			</section>

			<hr class="divider" />

			<!-- CONTACT -->
			<section id="contact" class="section">
				<h2 class="section-heading"><span class="prompt">//</span> Contact</h2>
				<div class="contact-row">
					<a href="mailto:alec@alecpullen.dev" class="contact-link">
						<span class="contact-icon">@</span>
						alec@alecpullen.dev
					</a>
					<a href="https://www.linkedin.com/in/alec-pullen-97473b272" target="_blank" class="contact-link">
						<span class="contact-icon">in</span>
						linkedin.com/in/alec-pullen
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* ── Layout ── */
	main {
		max-width: 860px;
		margin: 0 auto;
		padding: 0 2rem 4rem;
	}
	.section {
		padding: 4rem 0;
	}
	.divider {
		border: none;
		border-top: 1px solid var(--border-color);
		margin: 0;
	}

	/* ── Section headings ── */
	.section-heading {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		margin-bottom: 2rem;
	}
	.section-heading .prompt {
		color: var(--accent);
		margin-right: 0.5ch;
		font-weight: 400;
	}

	/* ── Hero ── */
	.hero {
		padding: 5rem 0 4rem;
	}
	.hero-label {
		font-size: 0.75rem;
		color: var(--accent);
		letter-spacing: 0.08em;
		margin-bottom: 1rem;
		opacity: 0.7;
	}
	.hero h1 {
		font-size: 2.8rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 0.4rem;
		line-height: 1.1;
	}
	.hero-title {
		font-size: 1rem;
		color: var(--accent);
		margin: 0 0 1.2rem;
		font-weight: 400;
	}
	.hero-bio {
		font-size: 0.9rem;
		color: rgb(var(--gray-dark));
		max-width: 480px;
		margin: 0 0 2rem;
		line-height: 1.6;
	}
	.hero-actions {
		display: flex;
		gap: 0.75rem;
	}
	.btn {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		padding: 0.5rem 1.25rem;
		border-radius: 3px;
		text-decoration: none;
		font-weight: 500;
		transition: background 0.15s, color 0.15s, border-color 0.15s;
	}
	.btn-primary {
		background: var(--accent);
		color: var(--dark-bg);
		border: 1px solid var(--accent);
	}
	.btn-primary:hover {
		background: var(--accent-dark);
		border-color: var(--accent-dark);
		color: var(--dark-bg);
	}
	.btn-secondary {
		background: transparent;
		color: rgb(var(--gray-dark));
		border: 1px solid var(--border-color);
	}
	.btn-secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* ── Skills ── */
	.skills {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 2rem;
	}
	.skill-group {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.skill-label {
		font-size: 0.72rem;
		color: rgb(var(--gray));
		letter-spacing: 0.05em;
		text-transform: uppercase;
		width: 5.5rem;
		flex-shrink: 0;
	}
	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.pill {
		font-size: 0.78rem;
		padding: 0.25rem 0.75rem;
		background: var(--card-bg);
		border: 1px solid var(--accent);
		color: var(--accent);
		border-radius: 3px;
		letter-spacing: 0.02em;
	}

	/* ── Project cards ── */
	.project-grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.project-card {
		display: grid;
		grid-template-columns: 240px 1fr;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 4px;
		overflow: hidden;
		transition: border-color 0.15s;
		min-height: 160px;
	}
	.project-card:hover {
		border-color: var(--accent);
	}
	.card-image {
		border-right: 1px solid var(--border-color);
		background: #0c0e14;
		overflow: hidden;
	}
	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		opacity: 0.9;
	}
	.card-content {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}
	.card-body {
		padding: 1.25rem 1.5rem 1rem;
	}
	.card-title {
		font-size: 1rem;
		font-weight: 600;
		color: rgb(var(--black));
		margin: 0 0 0.5rem;
	}
	.card-desc {
		font-size: 0.82rem;
		color: rgb(var(--gray-dark));
		line-height: 1.6;
		margin: 0;
	}
	.card-footer {
		padding: 0.75rem 1.5rem;
		border-top: 1px solid var(--border-color);
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.badge {
		font-size: 0.7rem;
		padding: 0.15rem 0.55rem;
		background: rgba(6, 182, 212, 0.08);
		color: var(--accent);
		border: 1px solid rgba(6, 182, 212, 0.25);
		border-radius: 2px;
		letter-spacing: 0.03em;
	}

	/* ── Contact ── */
	.contact-row {
		display: flex;
		gap: 2.5rem;
		flex-wrap: wrap;
	}
	.contact-link {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.88rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: color 0.15s;
	}
	.contact-link:hover {
		color: var(--accent);
	}
	.contact-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.6rem;
		height: 1.6rem;
		border: 1px solid var(--border-color);
		border-radius: 3px;
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--accent);
		flex-shrink: 0;
	}

	/* ── Responsive ── */
	@media (max-width: 640px) {
		.project-card {
			grid-template-columns: 1fr;
			grid-template-rows: 180px auto;
		}
		.card-image {
			border-right: none;
			border-bottom: 1px solid var(--border-color);
		}
		.hero h1 {
			font-size: 2rem;
		}
	}
</style>
